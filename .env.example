# =============================================================================
# AUREN SOLIAN — Organizational Intelligence & Company AI Platform
# Canonical Environment Configuration Template (Phase 3A)
#
# INSTRUCTIONS:
# Copy this file to '.env' for local development or configure in your deployment
# dashboard (Railway / Vercel). NEVER commit active secrets or keys to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application & Runtime Configuration
# -----------------------------------------------------------------------------
# Environment: 'development' | 'test' | 'staging' | 'production'
# In 'production', security validators disallow weak secrets and dev auth bypass.
ENVIRONMENT=development
APP_NAME="AUREN SOLIAN Company AI API"
PORT=8000
HOST=0.0.0.0
DEBUG=false
API_V1_STR=/api/v1

# -----------------------------------------------------------------------------
# 2. Enterprise Tenant Identity (Solian Wolves)
# -----------------------------------------------------------------------------
ORGANIZATION_ID=org-solian-wolves
ORGANIZATION_NAME="Solian Wolves"
ORGANIZATION_CODE=SLN-WLV

# -----------------------------------------------------------------------------
# 3. Database & Persistence Configuration
# -----------------------------------------------------------------------------
# For Local Development: Leave DATABASE_URL empty to use SQLite.
# For Supabase / Production: Provide the PostgreSQL connection string.
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
DATABASE_PATH=solian_enterprise.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_AUTO_MIGRATE=true

# -----------------------------------------------------------------------------
# 4. Security, Cryptographic Authentication & RBAC
# -----------------------------------------------------------------------------
# Auth Enforcement Mode:
#   'auto'       - Accepts signed JWTs, falls back to X-User-Id in development only.
#   'jwt'        - Strict JWT verification only (required in production).
#   'simulation' - Development simulation only (strictly prohibited in production).
AUTH_MODE=auto

# Cryptographic Secret Key (Used for internal session/token signing)
# In production, this MUST be a random string of at least 32 characters.
SECRET_KEY=solian-enterprise-dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase Auth & JWT Verification
# Obtain these from your Supabase Project Settings -> API / Authentication
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_for_token_verification
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated

# -----------------------------------------------------------------------------
# 5. AI & Large Language Model (LLM) Configuration
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Corporate Knowledge Embeddings & Vector Search
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 6. CORS Policy Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# In production, wildcards (*) are automatically stripped.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://frontend-solian-wolves.vercel.app
