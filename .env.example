# =============================================================================
# AUREN SOLIAN — Company AI & Organizational Intelligence Platform
# Environment Configuration Template
# =============================================================================

# Application Settings
ENVIRONMENT=development
APP_NAME="AUREN SOLIAN Company AI API"
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider Configuration (Google Gemini / Anthropic / OpenAI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=your_gemini_api_key_here

# Embedding Configuration for Corporate Knowledge Retrieval
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_API_KEY=your_gemini_api_key_here

# Supabase Database & Auth (Staging / Production)
# Leave blank for local SQLite development mode
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Organization Security & RBAC Configuration
ORGANIZATION_ID=default-corp
SESSION_EXPIRE_MINUTES=480

